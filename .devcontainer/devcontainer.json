{
  "name": "Winnow",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",

  // Smallest Codespaces machine (2 cores, 8 GB RAM) is enough for milestones M0-M4.
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },

  "features": {
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/devcontainers/features/terraform:1": {}
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "ms-vscode.cpptools",
        "hashicorp.terraform"
      ]
    }
  }
}
